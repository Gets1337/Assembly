generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  birthDate DateTime
  fullName  String
  login     String   @unique
  password  String
  role_id   Int
  cart      Cart?
  orders    Order[]
  role      Role     @relation(fields: [role_id], references: [id])
}

model Role {
  id    Int    @id @default(autoincrement())
  name  String @unique
  users User[]
}

model Order {
  id             Int              @id @default(autoincrement())
  created_at     DateTime         @default(now())
  status_id      Int
  updated_at     DateTime         @updatedAt
  user_id        Int
  payment_method String
  total_amount   Decimal          @default(0)
  status         OrderStatus      @relation(fields: [status_id], references: [id])
  user           User             @relation(fields: [user_id], references: [id])
  history        OrderHistory[]
  products       ProductInOrder[]
}

model OrderHistory {
  id              Int         @id @default(autoincrement())
  orderId         Int
  currentStatusId Int
  newStatusId     Int
  created_at      DateTime    @default(now())
  current_status  OrderStatus @relation("CurrentStatus", fields: [currentStatusId], references: [id])
  new_status      OrderStatus @relation("NewStatus", fields: [newStatusId], references: [id])
  order           Order       @relation(fields: [orderId], references: [id])
}

model OrderStatus {
  id                 Int            @id @default(autoincrement())
  name               String         @unique
  orders             Order[]
  current_in_history OrderHistory[] @relation("CurrentStatus")
  new_in_history     OrderHistory[] @relation("NewStatus")
}

model Product {
  id             Int              @id @default(autoincrement())
  name           String
  description    String?
  created_at     DateTime         @default(now())
  image_url      String?
  stock_quantity Int
  updated_at     DateTime?        @updatedAt
  price          Decimal          @default(0)
  cartItems      CartItem[]
  cells          ProductInCells[]
  orders         ProductInOrder[]
  reserves       Reserve[]
}

model ProductInOrder {
  id         Int      @id @default(autoincrement())
  orderId    Int
  productId  Int
  quantity   Int      @default(1)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  order      Order    @relation(fields: [orderId], references: [id])
  product    Product  @relation(fields: [productId], references: [id])
}

model StorageCell {
  id          Int              @id @default(autoincrement())
  description String
  created_at  DateTime         @default(now())
  updated_at  DateTime         @updatedAt
  products    ProductInCells[]
}

model ProductInCells {
  id         Int         @id @default(autoincrement())
  productId  Int
  cellId     Int
  quantity   Int
  created_at DateTime    @default(now())
  updated_at DateTime    @updatedAt
  cell       StorageCell @relation(fields: [cellId], references: [id])
  product    Product     @relation(fields: [productId], references: [id])
}

model Reserve {
  id         Int      @id @default(autoincrement())
  productId  Int
  quantity   Int
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  cartId     Int
  Cart       Cart     @relation(fields: [cartId], references: [id])
  product    Product  @relation(fields: [productId], references: [id])
}

model Info {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String
}

model Cart {
  id         Int        @id @default(autoincrement())
  user_id    Int        @unique
  created_at DateTime   @default(now())
  updated_at DateTime   @updatedAt
  user       User       @relation(fields: [user_id], references: [id])
  items      CartItem[]
  Reserve    Reserve[]
}

model CartItem {
  id         Int      @id @default(autoincrement())
  cart_id    Int
  product_id Int
  quantity   Int
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  cart       Cart     @relation(fields: [cart_id], references: [id])
  product    Product  @relation(fields: [product_id], references: [id])
}
