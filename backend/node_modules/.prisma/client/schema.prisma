generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 1. Пользователи
model User {
  id        Int      @id @default(autoincrement())
  birthDate DateTime
  fullName  String
  login     String   @unique
  password  String
  role_id   Int
  role      Role     @relation(fields: [role_id], references: [id])
  orders    Order[]
}

// 2. Роли
model Role {
  id    Int    @id @default(autoincrement())
  name  String @unique
  users User[]
}

// 3. Заказы
model Order {
  id         Int              @id @default(autoincrement())
  created_at DateTime         @default(now())
  updated_at DateTime         @updatedAt
  status_id  Int
  user_id    Int
  user       User             @relation(fields: [user_id], references: [id])
  status     OrderStatus      @relation(fields: [status_id], references: [id])
  products   ProductInOrder[]
  history    OrderHistory[]
}

// 4. История заказов
model OrderHistory {
  id              Int         @id @default(autoincrement())
  orderId         Int
  order           Order       @relation(fields: [orderId], references: [id])
  currentStatusId Int
  current_status  OrderStatus @relation("CurrentStatus", fields: [currentStatusId], references: [id])
  newStatusId     Int
  new_status      OrderStatus @relation("NewStatus", fields: [newStatusId], references: [id])
  created_at      DateTime    @default(now())
}

// 5. Статусы заказа
model OrderStatus {
  id                 Int            @id @default(autoincrement())
  name               String         @unique
  orders             Order[]
  current_in_history OrderHistory[] @relation("CurrentStatus")
  new_in_history     OrderHistory[] @relation("NewStatus")
}

// 6. Продукты
model Product {
  id             Int              @id @default(autoincrement())
  name           String
  description    String?
  image_url      String?
  stock_quantity Int
  cells          ProductInCells[]
  orders         ProductInOrder[]
  reserves       Reserve[]
  created_at     DateTime         @default(now())
  updated_at     DateTime?        @updatedAt
}

// 7. Продукты в заказах 
model ProductInOrder {
  id         Int      @id @default(autoincrement())
  orderId    Int
  order      Order    @relation(fields: [orderId], references: [id])
  productId  Int
  product    Product  @relation(fields: [productId], references: [id])
  quantity   Int      @default(1)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

// 8. Система хранения 
model StorageCell {
  id          Int              @id @default(autoincrement())
  description String
  products    ProductInCells[]
  created_at  DateTime         @default(now())
  updated_at  DateTime         @updatedAt
}

// 9. Продукты в ячейках
model ProductInCells {
  id         Int         @id @default(autoincrement())
  productId  Int
  product    Product     @relation(fields: [productId], references: [id])
  cellId     Int
  cell       StorageCell @relation(fields: [cellId], references: [id])
  quantity   Int
  created_at DateTime    @default(now())
  updated_at DateTime    @updatedAt
}

// 10. Резервы 
model Reserve {
  id         Int      @id @default(autoincrement())
  productId  Int
  product    Product  @relation(fields: [productId], references: [id])
  quantity   Int
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

// 11. Информация о системе 
model Info {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String
}
